<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banking Security Simulation - Hacker Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Hacker/Matrix Theme */
        :root {
            --bg-color: #000000;
            --panel-bg: #001100;
            --border-color: #00ff00;
            --text-primary: #00ff00;
            --text-secondary: #00cc00;
            --accent-color: #ff0000;
            --warning-color: #ffff00;
            --danger-color: #ff0000;
            --success-color: #00ff00;
            --font-mono: 'Courier New', monospace;
            --font-sys: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-sys);
            background-color: var(--bg-color);
            color: var(--text-primary);
            overflow-x: hidden;
            position: relative;
            height: 100vh;
        }

        /* Matrix background effect */
        #matrix-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
            opacity: 0.1;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
        }

        h1 {
            color: var(--text-primary);
            text-align: center;
            margin-bottom: 20px;
            font-size: 2.5rem;
            text-shadow: 0 0 10px var(--text-primary);
            letter-spacing: 2px;
            font-family: var(--font-mono);
        }

        .panel {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 0 15px var(--border-color);
            position: relative;
            overflow: hidden;
        }

        .panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90px, transparent, var(--border-color), transparent);
            animation: scanline 2s linear infinite;
        }

        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100vh); }
        }

        .panel h2 {
            color: var(--text-primary);
            margin-top: 0;
            margin-bottom: 15px;
            font-size: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
            font-family: var(--font-mono);
        }

        .controls {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .control-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        label {
            font-weight: bold;
            color: var(--text-secondary);
            font-family: var(--font-mono);
            text-shadow: 0 0 5px var(--text-secondary);
        }

        select, input {
            padding: 8px 12px;
            background: #000800;
            border: 1px solid var(--border-color);
            border-radius: 3px;
            color: var(--text-primary);
            font-family: var(--font-mono);
            font-size: 0.9rem;
        }

        select:focus, input:focus {
            outline: none;
            box-shadow: 0 0 8px var(--text-primary);
        }

        button {
            padding: 10px 18px;
            background: rgba(0, 0, 0, 0.7);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            border-radius: 3px;
            cursor: pointer;
            font-family: var(--font-mono);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(0, 255, 0, 0.2),
                transparent
            );
            transition: 0.5s;
        }

        button:hover::before {
            left: 100%;
        }

        button:hover {
            background: rgba(0, 10, 0, 0.8);
            box-shadow: 0 0 15px var(--text-primary);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        button.danger {
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

        button.danger:hover {
            box-shadow: 0 0 15px var(--danger-color);
            background: rgba(10, 0, 0, 0.8);
        }

        button.success {
            border-color: var(--success-color);
            color: var(--success-color);
        }

        button.success:hover {
            box-shadow: 0 0 15px var(--success-color);
            background: rgba(0, 10, 0, 0.8);
        }

        .status {
            display: flex;
            gap: 20px;
            margin: 15px 0;
        }

        .status-item {
            background: rgba(0, 10, 0, 0.3);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
            text-align: center;
            flex: 1;
            position: relative;
        }

        .status-label {
            font-size: 12px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: var(--font-mono);
        }

        .status-value {
            font-size: 2rem;
            font-weight: bold;
            margin: 8px 0;
            font-family: var(--font-mono);
            text-shadow: 0 0 5px var(--text-primary);
        }

        .status-value.ddos-active { color: var(--danger-color); text-shadow: 0 0 8px var(--danger-color); }
        .status-value.sql-active { color: var(--danger-color); text-shadow: 0 0 8px var(--danger-color); }
        .status-value.ddos-stopped { color: var(--success-color); text-shadow: 0 0 4px var(--success-color); }
        .status-value.sql-stopped { color: var(--success-color); text-shadow: 0 0 4px var(--success-color); }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .stat-card {
            background: rgba(0, 10, 0, 0.3);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
            text-align: center;
            position: relative;
        }

        .stat-card h3 {
            margin: 0 0 10px 0;
            font-size: 1rem;
            color: var(--text-secondary);
            font-family: var(--font-mono);
            text-transform: uppercase;
        }

        .stat-value {
            font-size: 2.2rem;
            font-weight: bold;
            color: var(--text-primary);
            margin: 8px 0;
            font-family: var(--font-mono);
            text-shadow: 0 0 5px var(--text-primary);
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--text-secondary);
            font-family: var(--font-mono);
        }

        .logs {
            background: rgba(0, 10, 0, 0.4);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
            height: 300px;
            overflow-y: auto;
            font-family: var(--font-mono);
            font-size: 13px;
            position: relative;
        }

        .logs::-webkit-scrollbar {
            width: 8px;
        }

        .logs::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.5);
        }

        .logs::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

        .log-entry {
            margin: 6px 0;
            padding: 8px;
            border-left: 3px solid var(--border-color);
            background: rgba(0, 0, 0, 0.2);
        }

        .log-entry.attack {
            border-left-color: var(--danger-color);
            background: rgba(20, 0, 0, 0.3);
        }

        .log-entry.defense {
            border-left-color: var(--success-color);
            background: rgba(0, 20, 0, 0.3);
        }

        .log-entry.info {
            border-left-color: var(--text-secondary);
            background: rgba(0, 0, 20, 0.2);
        }

        .log-entry.warning {
            border-left-color: var(--warning-color);
            background: rgba(20, 20, 0, 0.3);
        }

        .log-entry .timestamp {
            color: var(--text-secondary);
            font-weight: bold;
            margin-right: 8px;
        }

        .log-entry .message {
            flex: 1;
        }

        /* Charts container */
        .charts-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }

        .chart-card {
            background: rgba(0, 10, 0, 0.3);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
        }

        .chart-card h3 {
            margin: 0 0 12px 0;
            font-size: 1.1rem;
            color: var(--text-primary);
            font-family: var(--font-mono);
            text-align: center;
        }

        canvas {
            width: 100% !important;
            height: 200px !important;
        }

        /* Network visualization */
        .network-viz {
            background: rgba(0, 10, 0, 0.3);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 15px;
            height: 250px;
            position: relative;
            overflow: hidden;
        }

        .network-viz canvas {
            width: 100% !important;
            height: 100% !important;
        }

        /* Attack map */
        #attack-map {
            width: 100%;
            height: 200px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            margin: 10px 0;
            position: relative;
        }

        /* Pulse animation for active attacks */
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(0, 255, 0, 0); }
            100% { box-shadow: 0 0 0 0 rgba(0, 255, 0, 0); }
        }

        .pulse-active {
            animation: pulse 2s infinite;
        }

        /* Terminal-style input */
        .terminal-input {
            background: #000;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            font-family: var(--font-mono);
            padding: 12px;
            width: 100%;
            margin: 10px 0;
            border-radius: 3px;
            font-size: 1rem;
        }

        .terminal-input:focus {
            outline: none;
            box-shadow: 0 0 10px var(--text-primary);
        }

        /* Hacker-style text effects */
        .hacker-text {
            font-family: var(--font-mono);
            letter-spacing: 1px;
            text-shadow: 0 0 5px var(--text-primary);
        }

        .glitch {
            position: relative;
        }

        .glitch::before {
            content: attr(data-text);
            position: absolute;
            left: -2px;
            text-shadow: -2px 0 var(--danger-color);
            top: 0;
            width: 100%;
            overflow: hidden;
            clip: rect(0, 900px, 0, 0);
            animation: glitch-anim 2s infinite linear alternate-reverse;
        }

        .glitch::after {
            content: attr(data-text);
            position: absolute;
            left: 2px;
            text-shadow: 2px 0 var(--success-color);
            top: 0;
            width: 100%;
            overflow: hidden;
            clip: rect(0, 900px, 0, 0);
            animation: glitch-anim 3s infinite linear alternate-reverse;
        }

        @keyframes glitch-anim {
            0% { clip: rect(42px, 9999px, 44px, 0); }
            5% { clip: rect(18px, 9999px, 196px, 0); }
            6% { clip: rect(86px, 9999px, 86px, 0); }
            8% { clip: rect(86px, 9999px, 94px, 0); }
            9% { clip: rect(108px, 9999px, 86px, 0); }
            10% { clip: rect(108px, 9999px, 172px, 0); }
            11% { clip: rect(32px, 9999px, 37px, 0); }
            12% { clip: rect(92px, 9999px, 98px, 0); }
            13% { clip: rect(8px, 9999px, 87px, 0); }
            14% { clip: rect(98px, 9999px, 85px, 0); }
            15% { clip: rect(118px, 9999px, 118px, 0); }
            16% { clip: rect(166px, 9999px, 124px, 0); }
            17% { clip: rect(126px, 9999px, 108px, 0); }
            18% { clip: rect(66px, 9999px, 136px, 0); }
            19% { clip: rect(178px, 9999px, 178px, 0); }
            20% { clip: rect(98px, 9999px, 108px, 0); }
            21% { clip: rect(106px, 9999px, 138px, 0); }
            22% { clip: rect(130px, 9999px, 126px, 0); }
            23% { clip: rect(38px, 9999px, 98px, 0); }
            24% { clip: rect(76px, 9999px, 80px, 0); }
            25% { clip: rect(38px, 9999px, 104px, 0); }
            26% { clip: rect(96px, 9999px, 110px, 0); }
            27% { clip: rect(100px, 9999px, 130px, 0); }
            28% { clip: rect(100px, 9999px, 134px, 0); }
            29% { clip: rect(80px, 9999px, 116px, 0); }
            30% { clip: rect(4px, 9999px, 172px, 0); }
            31% { clip: rect(58px, 9999px, 106px, 0); }
            32% { clip: rect(14px, 9999px, 108px, 0); }
            33% { clip: rect(126px, 9999px, 188px, 0); }
            34% { clip: rect(106px, 9999px, 142px, 0); }
            35% { clip: rect(130px, 9999px, 130px, 0); }
            36% { clip: rect(28px, 9999px, 180px, 0); }
            37% { clip: rect(20px, 9999px, 90px, 0); }
            38% { clip: rect(146px, 9999px, 120px, 0); }
            39% { clip: rect(10px, 9999px, 90px, 0); }
            40% { clip: rect(24px, 9999px, 88px, 0); }
            41% { clip: rect(198px, 9999px, 146px, 0); }
            42% { clip: rect(16px, 9999px, 114px, 0); }
            43% { clip: rect(96px, 9999px, 108px, 0); }
            44% { clip: rect(138px, 9999px, 90px, 0); }
            45% { clip: rect(78px, 9999px, 122px, 0); }
            46% { clip: rect(70px, 9999px, 116px, 0); }
            47% { clip: rect(90px, 9999px, 120px, 0); }
            48% { clip: rect(76px, 9999px, 128px, 0); }
            49% { clip: rect(12px, 9999px, 140px, 0); }
            50% { clip: rect(14px, 9999px, 102px, 0); }
            51% { clip: rect(0px, 9999px, 112px, 0); }
            52% { clip: rect(134px, 9999px, 104px, 0); }
            53% { clip: rect(134px, 9999px, 156px, 0); }
            54% { clip: rect(108px, 9999px, 92px, 0); }
            55% { clip: rect(108px, 9999px, 100px, 0); }
            56% { clip: rect(90px, 9999px, 100px, 0); }
            57% { clip: rect(110px, 9999px, 128px, 0); }
            58% { clip: rect(108px, 9999px, 96px, 0); }
            59% { clip: rect(100px, 9999px, 92px, 0); }
            60% { clip: rect(108px, 9999px, 98px, 0); }
            61% { clip: rect(114px, 9999px, 94px, 0); }
            62% { clip: rect(100px, 9999px, 114px, 0); }
            63% { clip: rect(106px, 9999px, 106px, 0); }
            64% { clip: rect(98px, 9999px, 110px, 0); }
            65% { clip: rect(30px, 9999px, 88px, 0); }
            66% { clip: rect(36px, 9999px, 90px, 0); }
            67% { clip: rect(130px, 9999px, 108px, 0); }
            68% { clip: rect(122px, 9999px, 126px, 0); }
            69% { clip: rect(88px, 9999px, 96px, 0); }
            70% { clip: rect(200px, 9999px, 86px, 0); }
            71% { clip: rect(18px, 9999px, 130px, 0); }
            72% { clip: rect(100px, 9999px, 106px, 0); }
            73% { clip: rect(6px, 9999px, 90px, 0); }
            74% { clip: rect(124px, 9999px, 100px, 0); }
            75% { clip: rect(188px, 9999px, 116px, 0); }
            76% { clip: rect(138px, 9999px, 128px, 0); }
            77% { clip: rect(64px, 9999px, 96px, 0); }
            78% { clip: rect(102px, 9999px, 98px, 0); }
            79% { clip: rect(48px, 9999px, 90px, 0); }
            80% { clip: rect(56px, 9999px, 96px, 0); }
            81% { clip: rect(66px, 9999px, 126px, 0); }
            82% { clip: rect(100px, 9999px, 94px, 0); }
            83% { clip: rect(138px, 9999px, 120px, 0); }
            84% { clip: rect(108px, 9999px, 102px, 0); }
            85% { clip: rect(124px, 9999px, 96px, 0); }
            86% { clip: rect(106px, 9999px, 124px, 0); }
            87% { clip: rect(130px, 9999px, 126px, 0); }
            88% { clip: rect(96px, 9999px, 114px, 0); }
            89% { clip: rect(98px, 9999px, 124px, 0); }
            90% { clip: rect(68px, 9999px, 100px, 0); }
            91% { clip: rect(110px, 9999px, 124px, 0); }
            92% { clip: rect(106px, 9999px, 112px, 0); }
            93% { clip: rect(84px, 9999px, 104px, 0); }
            94% { clip: rect(92px, 9999px, 110px, 0); }
            95% { clip: rect(36px, 9999px, 106px, 0); }
            96% { clip: rect(54px, 9999px, 126px, 0); }
            97% { clip: rect(28px, 9999px, 88px, 0); }
            98% { clip: rect(100px, 9999px, 100px, 0); }
            99% { clip: rect(96px, 9999px, 106px, 0); }
            100% { clip: rect(0px, 9999px, 108px, 0); }
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .container {
                padding: 10px;
                height: calc(100vh - 20px);
            }

            h1 {
                font-size: 2rem;
                margin-bottom: 15px;
            }

            .controls {
                flex-direction: column;
                align-items: stretch;
            }

            .control-group {
                flex-direction: column;
                align-items: flex-start;
            }

            .status {
                flex-wrap: wrap;
            }

            .status-item {
                flex: 1 0 45%;
                margin-bottom: 10px;
            }

            .stats-grid {
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            }

            .charts-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Matrix background -->
    <canvas id="matrix-bg"></canvas>

    <div class="container">
        <h1 class="hacker-text glitch" data-text="BANKING SECURITY SIMULATION">BANKING SECURITY SIMULATION</h1>

        <div class="panel">
            <h2>ATTACK CONTROLS</h2>
            <div class="controls">
                <div class="control-group">
                    <label for="ddos-type">ATTACK TYPE:</label>
                    <select id="ddos-type">
                        <option value="http">HTTP FLOOD</option>
                        <option value="udp">UDP FLOOD</option>
                        <option value="syn">SYN FLOOD</option>
                    </select>
                </div>
                <div class="control-group">
                    <label for="ddos-duration">DURATION (S):</label>
                    <input type="number" id="ddos-duration" value="10" min="1" max="60">
                </div>
                <div class="control-group">
                    <label for="ddos-threads">THREADS:</label>
                    <input type="number" id="ddos-threads" value="5" min="1" max="20">
                </div>
                <button onclick="startDDoS()" class="danger">LAUNCH DDoS ATTACK</button>
                <button onclick="startSQL()" class="danger">LAUNCH SQL INJECTION</button>
                <button onclick="testDefenses()" class="success">TEST DEFENSES</button>
                <button class="danger" onclick="clearLogs()">CLEAR LOGS</button>
            </div>

            <div class="status">
                <div class="status-item">
                    <div class="status-label">DDoS STATUS</div>
                    <div class="status-value" id="ddos-status">STOPPED</div>
                </div>
                <div class="status-item">
                    <div class="status-label">SQL STATUS</div>
                    <div class="status-value" id="sql-status">STOPPED</div>
                </div>
            </div>
        </div>

        <div class="charts-container">
            <div class="chart-card">
                <h3>ATTACK THROUGHPUT</h3>
                <canvas id="throughputChart"></canvas>
            </div>
            <div class="chart-card">
                <h3>DEFENSE EFFECTIVENESS</h3>
                <canvas id="defenseChart"></canvas>
            </div>
        </div>

        <div class="panel">
            <h2>NETWORK TRAFFIC VISUALIZATION</h2>
            <div class="network-viz">
                <canvas id="networkChart"></canvas>
            </div>
        </div>

        <div class="panel">
            <h2>ATTACK ORIGIN MAP</h2>
            <div id="attack-map" class="glitch" data-text="ATTACK ORIGIN MAP"></div>
        </div>

        <div class="panel">
            <h2>SIMULATION LOGS</h2>
            <div class="logs" id="logs"></div>
        </div>
    </div>

    <script>
        let statusInterval = null;
        let matrixInterval = null;
        let charts = {};
        let networkChartInstance = null;

        // Matrix background effect
        function initMatrixBg() {
            const canvas = document.getElementById('matrix-bg');
            const ctx = canvas.getContext('2d');

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            resize();
            window.addEventListener('resize', resize);

            const characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()';
            const fontSize = 14;
            const columns = canvas.width / fontSize;
            const drops = [];

            for (let i = 0; i < columns; i++) {
                drops[i] = 1;
            }

            function draw() {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = '#0f0';
                ctx.font = fontSize + 'px monospace';

                for (let i = 0; i < drops.length; i++) {
                    const text = characters[Math.floor(Math.random() * characters.length)];
                    ctx.fillText(text, i * fontSize, drops[i] * fontSize);

                    if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                        drops[i] = 0;
                    }
                    drops[i]++;
                }
            }

            matrixInterval = setInterval(draw, 50);
        }

        // Initialize charts
        function initCharts() {
            // Throughput chart
            const throughputCtx = document.getElementById('throughputChart').getContext('2d');
            charts.throughput = new Chart(throughputCtx, {
                type: 'line',
                data: {
                    labels: Array.from({length: 20}, (_, i) => `-${19-i}s`),
                    datasets: [{
                        label: 'Packets/sec',
                        data: Array(20).fill(0),
                        borderColor: '#ff0000',
                        backgroundColor: 'rgba(255, 0, 0, 0.1)',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: '#0f0'
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: '#0f0'
                            },
                            grid: {
                                color: 'rgba(0, 255, 0, 0.2)'
                            }
                        },
                        x: {
                            ticks: {
                                color: '#0f0'
                            },
                            grid: {
                                color: 'rgba(0, 255, 0, 0.2)'
                            }
                        }
                    }
                }
            });

            // Defense chart
            const defenseCtx = document.getElementById('defenseChart').getContext('2d');
            charts.defense = new Chart(defenseCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Blocked', 'Allowed'],
                    datasets: [{
                        data: [0, 100],
                        backgroundColor: ['#ff0000', '#00ff00'],
                        borderWidth: 2,
                        borderColor: '#000'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: '#0f0'
                            }
                        }
                    }
                }
            });

            // Network chart
            const networkCtx = document.getElementById('networkChart').getContext('2d');
            networkChartInstance = new Chart(networkCtx, {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Network Traffic',
                        data: [],
                        backgroundColor: '#ff0000',
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                color: '#0f0',
                                stepSize: 20
                            },
                            grid: {
                                color: 'rgba(0, 255, 0, 0.2)'
                            }
                        },
                        x: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                color: '#0f0',
                                stepSize: 20
                            },
                            grid: {
                                color: 'rgba(0, 255, 0, 0.2)'
                            }
                        }
                    }
                }
            });
        }

        function startDDoS() {
            const type = document.getElementById('ddos-type').value;
            const duration = parseInt(document.getElementById('ddos-duration').value);
            const threads = parseInt(document.getElementById('ddos-threads').value);

            fetch('/start_ddos', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({type, duration, threads})
            })
            .then(response => response.json())
            .then(data => {
                console.log(data);
                updateStatus();
                // Add visual feedback
                activateAttackVisuals();
            });
        }

        function startSQL() {
            const type = document.getElementById('ddos-type').value;
            const duration = parseInt(document.getElementById('ddos-duration').value);
            const threads = parseInt(document.getElementById('ddos-threads').value);

            fetch('/start_sql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({type, duration, threads})
            })
            .then(response => response.json())
            .then(data => {
                console.log(data);
                updateStatus();
                activateAttackVisuals();
            });
        }

        function testDefenses() {
            fetch('/test_defense', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({type: 'rate_limit'})
            })
            .then(response => response.json())
            .then(data => {
                console.log(data);
                updateStatus();
            });

            // Also test SQL injection defense
            fetch('/test_defense', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({type: 'sql_injection', query: "admin' OR '1'='1"})
            })
            .then(response => response.json())
            .then(data => {
                console.log(data);
                updateStatus();
            });
        }

        function clearLogs() {
            fetch('/clear_logs', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                console.log(data);
                updateLogs();
            });
        }

        function activateAttackVisuals() {
            // Add pulsating effect to buttons
            const ddosBtn = document.querySelector('button[onclick*="startDDoS"]');
            const sqlBtn = document.querySelector('button[onclick*="startSQL"]');

            ddosBtn.classList.add('pulse-active');
            sqlBtn.classList.add('pulse-active');

            setTimeout(() => {
                ddosBtn.classList.remove('pulse-active');
                sqlBtn.classList.remove('pulse-active');
            }, 3000);
        }

        function updateStatus() {
            fetch('/get_status')
            .then(response => response.json())
            .then(data => {
                // Update attack status
                const ddosStatus = document.getElementById('ddos-status');
                const sqlStatus = document.getElementById('sql-status');

                ddosStatus.textContent = data.ddos_active ? 'ACTIVE' : 'STOPPED';
                ddosStatus.className = `status-value ${data.ddos_active ? 'ddos-active' : 'ddos-stopped'}`;

                sqlStatus.textContent = data.sql_active ? 'ACTIVE' : 'STOPPED';
                sqlStatus.className = `status-value ${data.sql_active ? 'sql-active' : 'sql-stopped'}`;

                // Update stats
                document.getElementById('ddos-packets').textContent = data.stats.ddos_packets || 0;
                document.getElementById('sql-attempts').textContent = data.stats.sql_attempts || 0;
                document.getElementById('blocked-attempts').textContent = data.stats.blocked_attempts || 0;
                document.getElementById('rate-limited-ips').textContent = data.stats.rate_limited_ips || 0;

                // Update charts
                updateCharts(data);
                updateNetworkViz(data);
                updateAttackMap(data);

                // Update logs
                updateLogs();
            })
            .catch(err => console.error('Error fetching status:', err));
        }

        function updateCharts(data) {
            // Update throughput chart (simulated)
            if (charts.throughput) {
                const newData = [...charts.throughput.data.datasets[0].data.slice(1),
                                data.ddos_active ? Math.random() * 100 : 0];
                charts.throughput.data.datasets[0].data = newData;
                charts.throughput.update('silent');
            }

            // Update defense chart
            if (charts.defense) {
                const blocked = data.stats.blocked_attempts || 0;
                const total = Math.max((data.stats.sql_attempts || 1), 1);
                const allowed = total - blocked;
                const blockedPercent = (blocked / total) * 100;

                charts.defense.data.datasets[0].data = [blockedPercent, 100 - blockedPercent];
                charts.defense.update('silent');
            }
        }

        function updateNetworkViz(data) {
            if (!networkChartInstance) return;

            // Clear old data and add new points based on attack status
            networkChartInstance.data.datasets[0].data = [];

            if (data.ddos_active) {
                // Generate random network traffic points during attack
                for (let i = 0; i < 20; i++) {
                    networkChartInstance.data.datasets[0].data.push({
                        x: Math.random() * 100,
                        y: Math.random() * 100
                    });
                }
            } else {
                // Generate minimal background traffic
                for (let i = 0; i < 5; i++) {
                    networkChartInstance.data.datasets[0].data.push({
                        x: Math.random() * 30,
                        y: Math.random() * 30
                    });
                }
            }

            networkChartInstance.update('silent');
        }

        function updateAttackMap(data) {
            const map = document.getElementById('attack-map');

            // Clear previous content
            map.innerHTML = '';

            if (data.ddos_active || data.sql_active) {
                // Show attack indicators
                const attackCount = Math.max(
                    data.stats.ddos_packets > 0 ? Math.min(Math.floor(data.stats.ddos_packets / 50), 10) : 0,
                    data.stats.sql_attempts > 0 ? Math.min(data.stats.sql_attempts, 5) : 0
                );

                for (let i = 0; i < attackCount; i++) {
                    const dot = document.createElement('div');
                    dot.style.position = 'absolute';
                    dot.style.width = '8px';
                    dot.style.height = '8px';
                    dot.style.backgroundColor = '#ff0000';
                    dot.style.borderRadius = '50%';
                    dot.style.boxShadow = '0 0 8px #ff0000';
                    dot.style.left = `${Math.random() * 100}%`;
                    dot.style.top = `${Math.random() * 100}%`;
                    dot.style.animation = 'pulse 2s infinite';
                    map.appendChild(dot);
                }

                // Add attacking IP indicators
                const ipLabel = document.createElement('div');
                ipLabel.style.position = 'absolute';
                ipLabel.style.bottom = '5px';
                ipLabel.style.left = '5px';
                ipLabel.style.color = '#00ff00';
                ipLabel.style.fontFamily = 'Courier New, monospace';
                ipLabel.style.fontSize = '12px';
                ipLabel.textContent = `SOURCE: 192.168.1.${Math.floor(Math.random()*254)+1}`;
                map.appendChild(ipLabel);
            } else {
                // Show normal network
                const normalLabel = document.createElement('div');
                normalLabel.style.position = 'absolute';
                normalLabel.style.top = '50%';
                normalLabel.style.left = '50%';
                normalLabel.style.transform = 'translate(-50%, -50%)';
                normalLabel.style.color = '#00ff00';
                normalLabel.style.fontFamily = 'Courier New, monospace';
                normalLabel.style.fontSize = '14px';
                normalLabel.textContent = 'NETWORK NOMINAL';
                map.appendChild(normalLabel);
            }
        }

        function updateLogs() {
            fetch('/get_status')
            .then(response => response.json())
            .then(data => {
                const logsContainer = document.getElementById('logs');
                logsContainer.innerHTML = '';

                const logs = data.logs || [];
                logs.forEach(log => {
                    const logEntry = document.createElement('div');
                    logEntry.className = `log-entry ${log.level.toLowerCase()}`;

                    const timestampSpan = document.createElement('span');
                    timestampSpan.className = 'timestamp';
                    timestampSpan.textContent = `[${log.timestamp}]`;

                    const messageSpan = document.createElement('span');
                    messageSpan.className = 'message';
                    messageSpan.textContent = log.message;

                    logEntry.appendChild(timestampSpan);
                    logEntry.appendChild(messageSpan);
                    logsContainer.appendChild(logEntry);
                });

                // Scroll to bottom
                logsContainer.scrollTop = logsContainer.scrollHeight;
            })
            .catch(err => console.error('Error fetching logs:', err));
        }

        // Start periodic updates
        function startUpdates() {
            statusInterval = setInterval(updateStatus, 1500); // Update every 1.5 seconds
        }

        // Stop updates when page is unloaded
        window.addEventListener('beforeunload', () => {
            if (statusInterval) clearInterval(statusInterval);
            if (matrixInterval) clearInterval(matrixInterval);
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initMatrixBg();
            initCharts();
            startUpdates();
            updateStatus();
        });
    </script>
</body>
</html>