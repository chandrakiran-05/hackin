ain.csv')\n    val_df = pd.read_csv('data/replay/hi_small_validation.csv')\n\n    # Combine and sort by Date\n    df = pd.concat([train_df, val_df])\n    df['Date'] = pd.to_datetime(df['Date'])\n    df = df.sort_values('Date').reset_index(drop=True)\n\n    # Initialize data structures\n    graph_out = defaultdict(set)   # bank -> set of banks it has edges to (outgoing)\n    graph_in = defaultdict(set)    # bank -> set of banks that have edges to it (incoming)\n    outgoing_amounts = defaultdict(list)\n    incoming_amounts = defaultdict(list)\n\n    # Build the graph from all transactions\n    for _, row in df.iterrows():\n        from_bank = row['From Bank']\n        to_bank = row['To Bank']\n        amount = row['Amount']\n\n        graph_out[from_bank].add(to_bank)\n        graph_in[to_bank].add(from_bank)\n        outgoing_amounts[from_bank].append(amount)\n        incoming_amounts[to_bank].append(amount)\n\n    # Precompute features for each bank\n    # Fan-in and fan-out\n    _fan_in = {bank: len(in_set) for bank, in_set in graph_in.items()}\n    _fan_out = {bank: len(out_set) for bank, out_set in graph_out.items()}\n    # Degree (fan-in + fan-out)\n    all_banks = set(_fan_in.keys()) | set(_fan_out.keys())\n    _degree = {bank: _fan_in.get(bank, 0) + _fan_out.get(bank, 0) for bank in all_banks}\n\n    # Function to compute standard deviation\n    def std_dev(lst):\n        if len(lst) < 2:\n            return 0.0\n        mean = sum(lst) / len(lst)\n        variance = sum((x - mean) ** 2 for x in lst) / len(lst)\n        return math.sqrt(variance)\n\n    # Scatter (std of outgoing amounts) and Gather (std of incoming amounts)\n    _scatter = {bank: std_dev(outgoing_amounts[bank]) for bank in outgoing_amounts}\n    _gather = {bank: std_dev(incoming_amounts[bank]) for bank in incoming_amounts}\n    # For banks with no transactions, we already have default 0.0 from std_dev for empty list?\n    # But we want to cover all banks in all_banks for scatter and gather.\n    for bank in all_banks:\n        if bank not in _scatter:\n            _scatter[bank] = 0.0\n        if bank not in _gather:\n            _gather[bank] = 0.0\n\n    # Store the graph structures for cycle detection\n    _graph_out = {bank: neighbors for bank, neighbors in graph_out.items()}\n    _graph_in = {bank: neighbors for bank, neighbors in graph_in.items()}\n\n    # Load the trained models\n    _load_ml_models()\n\n    end_time = time.perf_counter()\n    startup_time = end_time - start_time\n    return startup_time\n\n\ndef _load_ml_models():\n    \"\"\"Load the trained ML models from disk\"\"\"\n    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp\n\n    try:\n        # Load raw-gbm-v1 model\n        with open('data/models/raw-gbm-v1.pkl', 'rb') as f:\n            model_data_raw = pickle.load(f)\n            _model_raw = model_data_raw['model']\n            _threshold_raw = model_data_raw['threshold']\n\n        # Load gfp-gbm-v1 model\n        with open('data/models/gfp-gbm-v1.pkl', 'rb') as f:\n            model_data_gfp = pickle.load(f)\n            _model_gfp = model_data_gfp['model']\n            _threshold_gfp = model_data_gfp['threshold']\n\n        # Load label encoders and feature names (from either model, they should be the same)\n        _label_encoders = model_data_raw['label_encoders']\n        _feature_names = model_data_raw['feature_names']\n\n        print(\"ML models loaded successfully\")\n    except Exception as e:\n        print(f\"Warning: Could not load ML models: {e}\")\n        print(\"Using placeholder scoring\")\n        # Set to None so we know to use fallback\n        _model_raw = None\n        _model_gfp = None\n\n\ndef _has_path(start, end, graph):\n    \"\"\"\n    Check if there is a path from start to end in the directed graph.\n    Uses BFS for efficiency.\n    \"\"\"\n    from collections import deque\n    if start == end:\n        return True\n    visited = set()\n    queue = deque([start])\n    while queue:\n        node = queue.popleft()\n        if node == end:\n            return True\n        if node in visited:\n            continue\n        visited.add(node)\n        for neighbor in graph.get(node, set()):\n            if neighbor not in visited:\n                queue.append(neighbor)\n    return False\n\n\ndef _extract_features(transaction):\n    \"\"\"\n    Extract features from a transaction for ML model scoring.\n    Returns feature array or None if feature extraction fails.\n    \"\"\"\n    try:\n        import pandas as pd\n        import numpy as np\n        from sklearn.preprocessing import LabelEncoder\n\n        # Create a DataFrame with the transaction\n        df = pd.DataFrame([transaction])\n\n        # Feature engineering (same as in training)\n        # Encode categorical variables using the loaded label encoders\n        df_feat = df.copy()\n\n        # Handle unknown categories by mapping to -1 or most frequent class\n        def safe_transform(encoder, values):\n            transformed = []\n            for val in values:\n                if val in encoder.classes_:\n                    transformed.append(encoder.transform([val])[0])\n                else:\n                    # Unknown category - use most frequent class (0) or -1\n                    transformed.append(0)  # Default to first class\n            return np.array(transformed)\n\n        df_feat['From Bank_encoded'] = safe_transform(_label_encoders['bank'], df_feat['From Bank'])\n        df_feat['To Bank_encoded'] = safe_transform(_label_encoders['bank'], df_feat['To Bank'])\n        df_feat['Transaction Type_encoded'] = safe_transform(_label_encoders['type'], df_feat['Transaction Type'])\n\n        # Numerical features\n        df_feat['Amount_log'] = np.log1p(df_feat['Amount'])\n\n        # Time-based features\n        df_feat['Date'] = pd.to_datetime(df_feat['Date'])\n        df_feat['Hour'] = df_feat['Date'].dt.hour\n        df_feat['DayOfWeek'] = df_feat['Date'].dt.dayofweek\n\n        # Select features in the correct order\n        feature_array = df_feat[_feature_names].values\n\n        return feature_array\n    except Exception as e:\n        print(f\"Warning: Feature extraction failed: {e}\")\n        return None\n\n\ndef score(transaction):\n    \"\"\"\n    Score the risk based on graph features and ML models.\n\n    Args:\n        transaction (dict): A transaction dictionary with keys:\n            'From Bank', 'To Bank', 'Amount', etc.\n\n    Returns:\n        dict: {'score': float, 'reasons': list of strings}\n              The score is a combination of graph features and ML model predictions.\n    \"\"\"\n    global _fan_in, _fan_out, _degree, _scatter, _gather, _graph_out, _graph_in\n    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp\n\n    from_bank = transaction.get('From Bank', '')\n    to_bank = transaction.get('To Bank', '')\n\n    # Get features for source bank (from_bank)\n    source_fan_in = _fan_in.get(from_bank, 0)\n    source_fan_out = _fan_out.get(from_bank, 0)\n    source_degree = _degree.get(from_bank, 0)\n    source_scatter = _scatter.get(from_bank, 0.0)\n    source_gather = _gather.get(from_bank, 0.0)\n\n    # Get features for target bank (to_bank)\n    target_fan_in = _fan_in.get(to_bank, 0)\n    target_fan_out = _fan_out.get(to_bank, 0)\n    target_degree = _degree.get(to_bank, 0)\n    target_scatter = _scatter.get(to_bank, 0.0)\n    target_gather = _gather.get(to_bank, 0.0)\n\n    # Check if adding this transaction would create a cycle:\n    # i.e., is there a path from to_bank to from_bank in the current graph?\n    would_create_cycle = 1 if _has_path(to_bank, from_bank, _graph_out) else 0\n\n    # Prepare reasons as a list of strings describing the features\n    reasons = [\n        f\"source_fan_in: {source_fan_in}\",\n        f\"source_fan_out: {source_fan_out}\",\n        f\"source_degree: {source_degree}\",\n        f\"source_scatter: {source_scatter:.4f}\",\n        f\"source_gather: {source_gather:.4f}\",\n        f\"target_fan_in: {target_fan_in}\",\n        f\"target_fan_out: {target_fan_out}\",\n        f\"target_degree: {target_degree}\",\n        f\"target_scatter: {target_scatter:.4f}\",\n        f\"target_gather: {target_gather:.4f}\",\n        f\"would_create_cycle: {would_create_cycle}\"\n    ]\n\n    # Try to get ML model score if models are loaded\n    ml_score = None\n    ml_reason = \"\"\n\n    if _model_raw is not None and _model_gfp is not None:\n        try:\n            # Extract features for ML models\n            features = _extract_features(transaction)\n            if features is not None:\n                # Get predictions from both models\n                proba_raw = _model_raw.predict_proba(features)[0, 1]  # Probability of fraud\n                proba_gfp = _model_gfp.predict_proba(features)[0, 1]  # Probability of fraud\n\n                # Apply thresholds to get binary predictions\n                pred_raw = 1 if proba_raw >= _threshold_raw else 0\n                pred_gfp = 1 if proba_gfp >= _threshold_gfp else 0\n\n                # Combine predictions (ensemble approach - average if both agree, weighted otherwise)\n                if pred_raw == pred_gfp:\n                    # Both models agree - use average probability\n                    ml_score = (proba_raw + proba_gfp) / 2\n                else:\n                    # Models disagree - use weighted average (raw gets slightly higher weight)\n                    ml_score = (proba_raw * 0.6 + proba_gfp * 0.4)\n\n                ml_reason = f\"ml_raw_proba: {proba_raw:.3f}, ml_gfp_proba: {proba_gfp:.3f}, ml_final: {ml_score:.3f}\"\n                reasons.append(ml_reason)\n            else:\n                # Feature extraction failed\n                ml_score = 0.5  # Neutral score\n                reasons.append(\"ml_score: feature_extraction_failed -> 0.500\")\n        except Exception as e:\n            # ML scoring failed\n            ml_score = 0.5  # Neutral score\n            reasons.append(f\"ml_score: ml_error({str(e)[:20]}...) -> 0.500\")\n    else:\n        # Models not loaded - use placeholder\n        ml_score = 0.5\n        reasons.append(\"ml_score: models_not_loaded -> 0.500\")\n\n    # Final score: combine graph-based features with ML score\n    # For now, we'll use the ML score as the primary score since it's more sophisticated\n    # In a production system, we might combine graph features with ML features differently\n    if ml_score is not None:\n        score_value = ml_score\n    else:\n        # Fallback to original placeholder if ML completely fails\n        score_value = 0.5\n        reasons.append(\"final_score: ml_failed -> using_placeholder_0.500\")\n\n    return {\"score\": score_value, \"reasons\": reasons}\n\n\ndef ingest():\n    \"\"\"Ingest data. Does nothing.\"\"\"\n    pass\n\n\nif __name__ == \"__main__\":\n    # Simple test when run directly\n    import time\n\n    # Test load and measure startup time\n    startup_time = load()\n    print(f\"load() executed successfully in {startup_time:.4f} seconds\")\n    assert startup_time < 90.0, f\"load() took too long: {startup_time:.4f} seconds (must be <90s)\"\n\n    # Create a dummy transaction for testing score()\n    dummy_transaction = {\n        'From Bank': 'Bank of America',\n        'To Bank': 'Chase',\n        'Amount': 100.50,\n        'Currency': 'USD',\n        'Transaction Type': 'Payment'\n    }\n\n    # Test score with timing\n    start = time.perf_counter()\n    result = score(dummy_transaction)\n    end = time.perf_counter()\n    elapsed_ms = (end - start) * 1000\n\n    print(f\"score() returned: {result}\")\n    print(f\"score() executed in {elapsed_ms:.4f} ms\")\n    # Assert that the result has a score and non-empty reasons\n    assert 'score' in result, \"score() returned missing 'score' key\"\n    assert 'reasons' in result, \"score() returned missing 'reasons' key\"\n    assert isinstance(result['reasons'], list) and len(result['reasons']) > 0, \"score() reasons should be a non-empty list\"\n    assert elapsed_ms < 10.0, f\"score() took too long: {elapsed_ms:.4f} ms (should be under 10ms for feature computation)\"\n\n    # Test ingest\n    ingest()\n    print(\"ingest() executed successfully\")\n\n    # Test Unavailable exception\n    try:\n        raise Unavailable(\"Engine unavailable\")\n    except Unavailable as e:\n        print(f\"Unavailable exception caught: {e}\")\n\n    print(\"All tests passed!\")","structuredPatch":[{"oldStart":12,"oldLines":11,"newStart":12,"newLines":20,"lines":[" _graph_out = {}  # adjacency list for outgoing edges: bank -> set of banks"," _graph_in = {}   # adjacency list for incoming edges: bank -> set of banks"," ","+# Global variables to hold the ML models","+_model_raw = None","+_model_gfp = None","+_label_encoders = None","+_feature_names = None","+_threshold_raw = 0.5","+_threshold_gfp = 0.5"," ","+"," def load():","     \"\"\"","     Load the risk engine by building the graph from train and validation data.","     Precomputes graph features for fan-in, fan-out, degree, scatter, gather.","+    Also loads the trained ML models.","     Returns the startup time in seconds.","     \"\"\"","     import pandas as pd"]},{"oldStart":24,"oldLines":8,"newStart":33,"newLines":11,"lines":["     from collections import defaultdict","     import math","     from collections import deque","+    import pickle","+    import os"," ","     global _fan_in, _fan_out, _degree, _scatter, _gather, _graph_out, _graph_in","+    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp"," ","     start_time = time.perf_counter()"," "]},{"oldStart":86,"oldLines":11,"newStart":98,"newLines":44,"lines":["     _graph_out = {bank: neighbors for bank, neighbors in graph_out.items()}","     _graph_in = {bank: neighbors for bank, neighbors in graph_in.items()}"," ","+    # Load the trained models","+    _load_ml_models()","+","     end_time = time.perf_counter()","     startup_time = end_time - start_time","     return startup_time"," "," ","+def _load_ml_models():","+    \"\"\"Load the trained ML models from disk\"\"\"","+    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp","+","+    try:","+        # Load raw-gbm-v1 model","+        with open('data/models/raw-gbm-v1.pkl', 'rb') as f:","+            model_data_raw = pickle.load(f)","+            _model_raw = model_data_raw['model']","+            _threshold_raw = model_data_raw['threshold']","+","+        # Load gfp-gbm-v1 model","+        with open('data/models/gfp-gbm-v1.pkl', 'rb') as f:","+            model_data_gfp = pickle.load(f)","+            _model_gfp = model_data_gfp['model']","+            _threshold_gfp = model_data_gfp['threshold']","+","+        # Load label encoders and feature names (from either model, they should be the same)","+        _label_encoders = model_data_raw['label_encoders']","+        _feature_names = model_data_raw['feature_names']","+","+        print(\"ML models loaded successfully\")","+    except Exception as e:","+        print(f\"Warning: Could not load ML models: {e}\")","+        print(\"Using placeholder scoring\")","+        # Set to None so we know to use fallback","+        _model_raw = None","+        _model_gfp = None","+","+"," def _has_path(start, end, graph):","     \"\"\"","     Check if there is a path from start to end in the directed graph."]},{"oldStart":114,"oldLines":22,"newStart":159,"newLines":69,"lines":["     return False"," "," ","+def _extract_features(transaction):","+    \"\"\"","+    Extract features from a transaction for ML model scoring.","+    Returns feature array or None if feature extraction fails.","+    \"\"\"","+    try:","+        import pandas as pd","+        import numpy as np","+        from sklearn.preprocessing import LabelEncoder","+","+        # Create a DataFrame with the transaction","+        df = pd.DataFrame([transaction])","+","+        # Feature engineering (same as in training)","+        # Encode categorical variables using the loaded label encoders","+        df_feat = df.copy()","+","+        # Handle unknown categories by mapping to -1 or most frequent class","+        def safe_transform(encoder, values):","+            transformed = []","+            for val in values:","+                if val in encoder.classes_:","+                    transformed.append(encoder.transform([val])[0])","+                else:","+                    # Unknown category - use most frequent class (0) or -1","+                    transformed.append(0)  # Default to first class","+            return np.array(transformed)","+","+        df_feat['From Bank_encoded'] = safe_transform(_label_encoders['bank'], df_feat['From Bank'])","+        df_feat['To Bank_encoded'] = safe_transform(_label_encoders['bank'], df_feat['To Bank'])","+        df_feat['Transaction Type_encoded'] = safe_transform(_label_encoders['type'], df_feat['Transaction Type'])","+","+        # Numerical features","+        df_feat['Amount_log'] = np.log1p(df_feat['Amount'])","+","+        # Time-based features","+        df_feat['Date'] = pd.to_datetime(df_feat['Date'])","+        df_feat['Hour'] = df_feat['Date'].dt.hour","+        df_feat['DayOfWeek'] = df_feat['Date'].dt.dayofweek","+","+        # Select features in the correct order","+        feature_array = df_feat[_feature_names].values","+","+        return feature_array","+    except Exception as e:","+        print(f\"Warning: Feature extraction failed: {e}\")","+        return None","+","+"," def score(transaction):","     \"\"\"","-    Score the risk based on graph features of the transaction.","-    Returns features matching QML export format (up to 16 named floats).","+    Score the risk based on graph features and ML models."," ","     Args:","         transaction (dict): A transaction dictionary with keys:","             'From Bank', 'To Bank', 'Amount', etc."," ","     Returns:","-        dict: Features dictionary with up to 16 named float values.","-              Features include: classical score (placeholder), and f_ features","-              for source and target banks (fan-in, fan-out, degree, scatter, gather)","-              and cycle detection flag.","+        dict: {'score': float, 'reasons': list of strings}","+              The score is a combination of graph features and ML model predictions.","     \"\"\"","     global _fan_in, _fan_out, _degree, _scatter, _gather, _graph_out, _graph_in","+    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp"," ","     from_bank = transaction.get('From Bank', '')","     to_bank = transaction.get('To Bank', '')"]},{"oldStart":152,"oldLines":28,"newStart":244,"newLines":74,"lines":["     # i.e., is there a path from to_bank to from_bank in the current graph?","     would_create_cycle = 1 if _has_path(to_bank, from_bank, _graph_out) else 0"," ","-    # Prepare features dictionary matching QML export format","-    # Classical score placeholder (to be replaced by trained model)","-    classical_score = 0.5","+    # Prepare reasons as a list of strings describing the features","+    reasons = [","+        f\"source_fan_in: {source_fan_in}\",","+        f\"source_fan_out: {source_fan_out}\",","+        f\"source_degree: {source_degree}\",","+        f\"source_scatter: {source_scatter:.4f}\",","+        f\"source_gather: {source_gather:.4f}\",","+        f\"target_fan_in: {target_fan_in}\",","+        f\"target_fan_out: {target_fan_out}\",","+        f\"target_degree: {target_degree}\",","+        f\"target_scatter: {target_scatter:.4f}\",","+        f\"target_gather: {target_gather:.4f}\",","+        f\"would_create_cycle: {would_create_cycle}\"","+    ]"," ","-    features = {","-        'classical_score': classical_score,","-        'f_source_fan_in': float(source_fan_in),","-        'f_source_fan_out': float(source_fan_out),","-        'f_source_degree': float(source_degree),","-        'f_source_scatter': source_scatter,","-        'f_source_gather': source_gather,","-        'f_target_fan_in': float(target_fan_in),","-        'f_target_fan_out': float(target_fan_out),","-        'f_target_degree': float(target_degree),","-        'f_target_scatter': target_scatter,","-        'f_target_gather': target_gather,","-        'f_would_create_cycle': float(would_create_cycle)","-    }","+    # Try to get ML model score if models are loaded","+    ml_score = None","+    ml_reason = \"\""," ","-    return features","+    if _model_raw is not None and _model_gfp is not None:","+        try:","+            # Extract features for ML models","+            features = _extract_features(transaction)","+            if features is not None:","+                # Get predictions from both models","+                proba_raw = _model_raw.predict_proba(features)[0, 1]  # Probability of fraud","+                proba_gfp = _model_gfp.predict_proba(features)[0, 1]  # Probability of fraud"," ","+                # Apply thresholds to get binary predictions","+                pred_raw = 1 if proba_raw >= _threshold_raw else 0","+                pred_gfp = 1 if proba_gfp >= _threshold_gfp else 0"," ","+                # Combine predictions (ensemble approach - average if both agree, weighted otherwise)","+                if pred_raw == pred_gfp:","+                    # Both models agree - use average probability","+                    ml_score = (proba_raw + proba_gfp) / 2","+                else:","+                    # Models disagree - use weighted average (raw gets slightly higher weight)","+                    ml_score = (proba_raw * 0.6 + proba_gfp * 0.4)","+","+                ml_reason = f\"ml_raw_proba: {proba_raw:.3f}, ml_gfp_proba: {proba_gfp:.3f}, ml_final: {ml_score:.3f}\"","+                reasons.append(ml_reason)","+            else:","+                # Feature extraction failed","+                ml_score = 0.5  # Neutral score","+                reasons.append(\"ml_score: feature_extraction_failed -> 0.500\")","+        except Exception as e:","+            # ML scoring failed","+            ml_score = 0.5  # Neutral score","+            reasons.append(f\"ml_score: ml_error({str(e)[:20]}...) -> 0.500\")","+    else:","+        # Models not loaded - use placeholder","+        ml_score = 0.5","+        reasons.append(\"ml_score: models_not_loaded -> 0.500\")","+","+    # Final score: combine graph-based features with ML score","+    # For now, we'll use the ML score as the primary score since it's more sophisticated","+    # In a production system, we might combine graph features with ML features differently","+    if ml_score is not None:","+        score_value = ml_score","+    else:","+        # Fallback to original placeholder if ML completely fails","+        score_value = 0.5","+        reasons.append(\"final_score: ml_failed -> using_placeholder_0.500\")","+","+    return {\"score\": score_value, \"reasons\": reasons}","+","+"," def ingest():","     \"\"\"Ingest data. Does nothing.\"\"\"","     pass"]}],"originalFile":"class Unavailable(Exception):\n    \"\"\"Exception raised when the risk engine is unavailable.\"\"\"\n    pass\n\n\n# Global variables to hold the precomputed graph features\n_fan_in = {}\n_fan_out = {}\n_degree = {}\n_scatter = {}\n_gather = {}\n_graph_out = {}  # adjacency list for outgoing edges: bank -> set of banks\n_graph_in = {}   # adjacency list for incoming edges: bank -> set of banks\n\n\ndef load():\n    \"\"\"\n    Load the risk engine by building the graph from train and validation data.\n    Precomputes graph features for fan-in, fan-out, degree, scatter, gather.\n    Returns the startup time in seconds.\n    \"\"\"\n    import pandas as pd\n    import time\n    from collections import defaultdict\n    import math\n    from collections import deque\n\n    global _fan_in, _fan_out, _degree, _scatter, _gather, _graph_out, _graph_in\n\n    start_time = time.perf_counter()\n\n    # Load train and validation data\n    train_df = pd.read_csv('data/replay/hi_small_train.csv')\n    val_df = pd.read_csv('data/replay/hi_small_validation.csv')\n\n    # Combine and sort by Date\n    df = pd.concat([train_df, val_df])\n    df['Date'] = pd.to_datetime(df['Date'])\n    df = df.sort_values('Date').reset_index(drop=True)\n\n    # Initialize data structures\n    graph_out = defaultdict(set)   # bank -> set of banks it has edges to (outgoing)\n    graph_in = defaultdict(set)    # bank -> set of banks that have edges to it (incoming)\n    outgoing_amounts = defaultdict(list)\n    incoming_amounts = defaultdict(list)\n\n    # Build the graph from all transactions\n    for _, row in df.iterrows():\n        from_bank = row['From Bank']\n        to_bank = row['To Bank']\n        amount = row['Amount']\n\n        graph_out[from_bank].add(to_bank)\n        graph_in[to_bank].add(from_bank)\n        outgoing_amounts[from_bank].append(amount)\n        incoming_amounts[to_bank].append(amount)\n\n    # Precompute features for each bank\n    # Fan-in and fan-out\n    _fan_in = {bank: len(in_set) for bank, in_set in graph_in.items()}\n    _fan_out = {bank: len(out_set) for bank, out_set in graph_out.items()}\n    # Degree (fan-in + fan-out)\n    all_banks = set(_fan_in.keys()) | set(_fan_out.keys())\n    _degree = {bank: _fan_in.get(bank, 0) + _fan_out.get(bank, 0) for bank in all_banks}\n\n    # Function to compute standard deviation\n    def std_dev(lst):\n        if len(lst) < 2:\n            return 0.0\n        mean = sum(lst) / len(lst)\n        variance = sum((x - mean) ** 2 for x in lst) / len(lst)\n        return math.sqrt(variance)\n\n    # Scatter (std of outgoing amounts) and Gather (std of incoming amounts)\n    _scatter = {bank: std_dev(outgoing_amounts[bank]) for bank in outgoing_amounts}\n    _gather = {bank: std_dev(incoming_amounts[bank]) for bank in incoming_amounts}\n    # For banks with no transactions, we already have default 0.0 from std_dev for empty list?\n    # But we want to cover all banks in all_banks for scatter and gather.\n    for bank in all_banks:\n        if bank not in _scatter:\n            _scatter[bank] = 0.0\n        if bank not in _gather:\n            _gather[bank] = 0.0\n\n    # Store the graph structures for cycle detection\n    _graph_out = {bank: neighbors for bank, neighbors in graph_out.items()}\n    _graph_in = {bank: neighbors for bank, neighbors in graph_in.items()}\n\n    end_time = time.perf_counter()\n    startup_time = end_time - start_time\n    return startup_time\n\n\ndef _has_path(start, end, graph):\n    \"\"\"\n    Check if there is a path from start to end in the directed graph.\n    Uses BFS for efficiency.\n    \"\"\"\n    from collections import deque\n    if start == end:\n        return True\n    visited = set()\n    queue = deque([start])\n    while queue:\n        node = queue.popleft()\n        if node == end:\n            return True\n        if node in visited:\n            continue\n        visited.add(node)\n        for neighbor in graph.get(node, set()):\n            if neighbor not in visited:\n                queue.append(neighbor)\n    return False\n\n\ndef score(transaction):\n    \"\"\"\n    Score the risk based on graph features of the transaction.\n    Returns features matching QML export format (up to 16 named floats).\n\n    Args:\n        transaction (dict): A transaction dictionary with keys:\n            'From Bank', 'To Bank', 'Amount', etc.\n\n    Returns:\n        dict: Features dictionary with up to 16 named float values.\n              Features include: classical score (placeholder), and f_ features\n              for source and target banks (fan-in, fan-out, degree, scatter, gather)\n              and cycle detection flag.\n    \"\"\"\n    global _fan_in, _fan_out, _degree, _scatter, _gather, _graph_out, _graph_in\n\n    from_bank = transaction.get('From Bank', '')\n    to_bank = transaction.get('To Bank', '')\n\n    # Get features for source bank (from_bank)\n    source_fan_in = _fan_in.get(from_bank, 0)\n    source_fan_out = _fan_out.get(from_bank, 0)\n    source_degree = _degree.get(from_bank, 0)\n    source_scatter = _scatter.get(from_bank, 0.0)\n    source_gather = _gather.get(from_bank, 0.0)\n\n    # Get features for target bank (to_bank)\n    target_fan_in = _fan_in.get(to_bank, 0)\n    target_fan_out = _fan_out.get(to_bank, 0)\n    target_degree = _degree.get(to_bank, 0)\n    target_scatter = _scatter.get(to_bank, 0.0)\n    target_gather = _gather.get(to_bank, 0.0)\n\n    # Check if adding this transaction would create a cycle:\n    # i.e., is there a path from to_bank to from_bank in the current graph?\n    would_create_cycle = 1 if _has_path(to_bank, from_bank, _graph_out) else 0\n\n    # Prepare features dictionary matching QML export format\n    # Classical score placeholder (to be replaced by trained model)\n    classical_score = 0.5\n\n    features = {\n        'classical_score': classical_score,\n        'f_source_fan_in': float(source_fan_in),\n        'f_source_fan_out': float(source_fan_out),\n        'f_source_degree': float(source_degree),\n        'f_source_scatter': source_scatter,\n        'f_source_gather': source_gather,\n        'f_target_fan_in': float(target_fan_in),\n        'f_target_fan_out': float(target_fan_out),\n        'f_target_degree': float(target_degree),\n        'f_target_scatter': target_scatter,\n        'f_target_gather': target_gather,\n        'f_would_create_cycle': float(would_create_cycle)\n    }\n\n    return features\n\n\ndef ingest():\n    \"\"\"Ingest data. Does nothing.\"\"\"\n    pass\n\n\nif __name__ == \"__main__\":\n    # Simple test when run directly\n    import time\n\n    # Test load and measure startup time\n    startup_time = load()\n    print(f\"load() executed successfully in {startup_time:.4f} seconds\")\n    assert startup_time < 90.0, f\"load() took too long: {startup_time:.4f} seconds (must be <90s)\"\n\n    # Create a dummy transaction for testing score()\n    dummy_transaction = {\n        'From Bank': 'Bank of America',\n        'To Bank': 'Chase',\n        'Amount': 100.50,\n        'Currency': 'USD',\n        'Transaction Type': 'Payment'\n    }\n\n    # Test score with timing\n    start = time.perf_counter()\n    result = score(dummy_transaction)\n    end = time.perf_counter()\n    elapsed_ms = (end - start) * 1000\n\n    print(f\"score() returned: {result}\")\n    print(f\"score() executed in {elapsed_ms:.4f} ms\")\n    # Assert that the result has a score and non-empty reasons\n    assert 'score' in result, \"score() returned missing 'score' key\"\n    assert 'reasons' in result, \"score() returned missing 'reasons' key\"\n    assert isinstance(result['reasons'], list) and len(result['reasons']) > 0, \"score() reasons should be a non-empty list\"\n    assert elapsed_ms < 10.0, f\"score() took too long: {elapsed_ms:.4f} ms (should be under 10ms for feature computation)\"\n\n    # Test ingest\n    ingest()\n    print(\"ingest() executed successfully\")\n\n    # Test Unavailable exception\n    try:\n        raise Unavailable(\"Engine unavailable\")\n    except Unavailable as e:\n        print(f\"Unavailable exception caught: {e}\")\n\n    print(\"All tests passed!\")","userModified":false},"sourceToolAssistantUUID":"8a553278-8b06-4378-9e6f-c7d037bf1935","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack","sessionId":"bf17b420-9618-43bc-84f2-60c55630bfc5","version":"2.1.268","gitBranch":"HEAD","slug":"harmonic-meandering-kazoo"}
{"parentUuid":"2c3a5253-ebfe-4eb5-9417-de6c2555de2b","isSidechain":true,"agentId":"ada7827e69a1c72f9","message":{"id":"87c13372-bc38-4a67-8676-5e1484e903c8","type":"message","role":"assistant","model":"nvidia/nemotron-3-super-120b-a12b","content":[{"type":"thinking","thinking":"Now I need to create a validation script to test that models produce same scores on laptop and VM (simulated). Since we're in a simulated environment, I'll create a script that loads the models and tests them on sample data to ensure they work consistently.","signature":""}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":68879,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":74,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"apiBlockIndex":0,"attributionAgent":"general-purpose","type":"assistant","uuid":"1b008459-e290-44f4-9ff5-3603288a9f20","timestamp":"2026-10-17T17:09:59.604Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack","sessionId":"bf17b420-9618-43bc-84f2-60c55630bfc5","version":"2.1.268","gitBranch":"HEAD","slug":"harmonic-meandering-kazoo"}
{"parentUuid":"1b008459-e290-44f4-9ff5-3603288a9f20","isSidechain":true,"agentId":"ada7827e69a1c72f9","message":{"id":"87c13372-bc38-4a67-8676-5e1484e903c8","type":"message","role":"assistant","model":"nvidia/nemotron-3-super-120b-a12b","content":[{"type":"tool_use","id":"call-090b9cde-3d6f-4212-ac15-e6275d83523d","name":"Write","input":{"file_path":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack\\validate_models.py","content":"\"\"\"\nValidation script for Model Development (PRD A-04 through A-06)\nTests that models produce consistent scores (simulating laptop vs VM consistency)\n\"\"\"\n\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport json\nimport time\nimport os\n\ndef load_models():\n    \"\"\"Load the trained models\"\"\"\n    print(\"Loading models...\")\n\n    # Load raw-gbm-v1 model\n    with open('data/models/raw-gbm-v1.pkl', 'rb') as f:\n        model_data_raw = pickle.load(f)\n        model_raw = model_data_raw['model']\n        threshold_raw = model_data_raw['threshold']\n        label_encoders = model_data_raw['label_encoders']\n        feature_names = model_data_raw['feature_names']\n\n    # Load gfp-gbm-v1 model\n    with open('data/models/gfp-gbm-v1.pkl', 'rb') as f:\n        model_data_gfp = pickle.load(f)\n        model_gfp = model_data_gfp['model']\n        threshold_gfp = model_data_gfp['threshold']\n\n    print(\"Models loaded successfully\")\n    return model_raw, model_gfp, threshold_raw, threshold_gfp, label_encoders, feature_names\n\ndef extract_features(transaction, label_encoders, feature_names):\n    \"\"\"Extract features from a transaction (same as in scoring/core.py)\"\"\"\n    try:\n        import pandas as pd\n        import numpy as np\n\n        # Create a DataFrame with the transaction\n        df = pd.DataFrame([transaction])\n\n        # Feature engineering (same as in training)\n        # Encode categorical variables using the loaded label encoders\n        df_feat = df.copy()\n\n        # Handle unknown categories by mapping to most frequent class\n        def safe_transform(encoder, values):\n            transformed = []\n            for val in values:\n                if val in encoder.classes_:\n                    transformed.append(encoder.transform([val])[0])\n                else:\n                    # Unknown category - use most frequent class (0)\n                    transformed.append(0)\n            return np.array(transformed)\n\n        df_feat['From Bank_encoded'] = safe_transform(label_encoders['bank'], df_feat['From Bank'])\n        df_feat['To Bank_encoded'] = safe_transform(label_encoders['bank'], df_feat['To Bank'])\n        df_feat['Transaction Type_encoded'] = safe_transform(label_encoders['type'], df_feat['Transaction Type'])\n\n        # Numerical features\n        df_feat['Amount_log'] = np.log1p(df_feat['Amount'])\n\n        # Time-based features\n        df_feat['Date'] = pd.to_datetime(df_feat['Date'])\n        df_feat['Hour'] = df_feat['Date'].dt.hour\n        df_feat['DayOfWeek'] = df_feat['Date'].dt.dayofweek\n\n        # Select features in the correct order\n        feature_array = df_feat[feature_names].values\n\n        return feature_array\n    except Exception as e:\n        print(f\"Warning: Feature extraction failed: {e}\")\n        return None\n\ndef test_model_consistency():\n    \"\"\"Test that models produce consistent results (simulating laptop vs VM)\"\"\"\n    print(\"=\" * 60)\n    print(\"MODEL CONSISTENCY VALIDATION\")\n    print(\"Testing that models produce same scores consistently\")\n    print(\"=\" * 60)\n\n    # Load models\n    model_raw, model_gfp, threshold_raw, threshold_gfp, label_encoders, feature_names = load_models()\n\n    # Load test data\n    test_df = pd.read_csv('data/replay/hi_small_test.csv')\n    print(f\"\\nLoaded {len(test_df)} test transactions\")\n\n    # Create simple labels for testing (same approach as training)\n    def create_fault_label(row):\n        if row['Transaction Type'] == 'Transfer' and row['From Bank'] != row['To Bank']:\n            if row['Amount'] > 200:\n                return 1\n        elif row['Transaction Type'] == 'Payment' and row['Amount'] > 500:\n            return 1\n        return 0\n\n    test_df['is_fraud'] = test_df.apply(create_fault_label, axis=1)\n    print(f\"Fraud rate in test data: {test_df['is_fraud'].mean():.3f}\")\n\n    # Test multiple runs to simulate laptop vs VM consistency\n    print(\"\\nRunning consistency tests...\")\n\n    # Store results from multiple runs\n    results_raw = []\n    results_gfp = []\n\n    # Run 5 times to check consistency\n    for run in range(5):\n        print(f\"\\nRun {run + 1}:\")\n\n        scores_raw = []\n        scores_gfp = []\n        predictions_raw = []\n        predictions_gfp = []\n\n        # Process each transaction\n        for idx, row in test_df.iterrows():\n            transaction = row.to_dict()\n\n            # Extract features\n            features = extract_features(transaction, label_encoders, feature_names)\n\n            if features is not None:\n                # Get predictions from both models\n                proba_raw = model_raw.predict_proba(features)[0, 1]\n                proba_gfp = model_gfp.predict_proba(features)[0, 1]\n\n                # Apply thresholds\n                pred_raw = 1 if proba_raw >= threshold_raw else 0\n                pred_gfp = 1 if proba_gfp >= threshold_gfp else 0\n\n                scores_raw.append(proba_raw)\n                scores_gfp.append(proba_gfp)\n                predictions_raw.append(pred_raw)\n                predictions_gfp.append(pred_gfp)\n            else:\n                # Feature extraction failed\n                scores_raw.append(0.5)\n                scores_gfp.append(0.5)\n                predictions_raw.append(0)\n                predictions_gfp.append(0)\n\n        results_raw.append({\n            'scores': scores_raw,\n            'predictions': predictions_raw\n        })\n\n        results_gfp.append({\n            'scores': scores_gfp,\n            'predictions': predictions_gfp\n        })\n\n        print(f\"  Raw-GBM-V1: {sum(predictions_raw)} predictions of {len(predictions_raw)}\")\n        print(f\"  GFP-GBM-V1: {sum(predictions_gfp)} predictions of {len(predictions_gfp)}\")\n\n    # Check consistency across runs\n    print(\"\\nChecking consistency across runs...\")\n\n    # For raw-gbm-v1\n    raw_scores_consistent = True\n    raw_preds_consistent = True\n\n    first_raw_scores = results_raw[0]['scores']\n    first_raw_preds = results_raw[0]['predictions']\n\n    for i, run_result in enumerate(results_raw[1:], 1):\n        if run_result['scores'] != first_raw_scores:\n            raw_scores_consistent = False\n            print(f\"  Raw-GBM-V1 scores differ in run {i+1}\")\n        if run_result['predictions'] != first_raw_preds:\n            raw_preds_consistent = False\n            print(f\"  Raw-GBM-V1 predictions differ in run {i+1}\")\n\n    # For gfp-gbm-v1\n    gfp_scores_consistent = True\n    gfp_preds_consistent = True\n\n    first_gfp_scores = results_gfp[0]['scores']\n    first_gfp_preds = results_gfp[0]['predictions']\n\n    for i, run_result in enumerate(results_gfp[1:], 1):\n        if run_result['scores'] != first_gfp_scores:\n            gfp_scores_consistent = False\n            print(f\"  GFP-GBM-V1 scores differ in run {i+1}\")\n        if run_result['predictions'] != first_gfp_preds:\n            gfp_preds_consistent = False\n            print(f\"  GFP-GBM-V1 predictions differ in run {i+1}\")\n\n    # Summary\n    print(\"\\n\" + \"=\" * 60)\n    print(\"CONSISTENCY TEST RESULTS\")\n    print(\"=\" * 60)\n    print(f\"Raw-GBM-V1 scores consistent across runs: {raw_scores_consistent}\")\n    print(f\"Raw-GBM-V1 predictions consistent across runs: {raw_preds_consistent}\")\n    print(f\"GFP-GBM-V1 scores consistent across runs: {gfp_scores_consistent}\")\n    print(f\"GFP-GBM-V1 predictions consistent across runs: {gfp_preds_consistent}\")\n\n    all_consistent = raw_scores_consistent and raw_preds_consistent and gfp_scores_consistent and gfp_preds_consistent\n\n    if all_consistent:\n        print(\"\\n✓ ALL CONSISTENCY TESTS PASSED\")\n        print(\"Models produce same scores consistently (simulating laptop vs VM consistency)\")\n    else:\n        print(\"\\n✗ SOME CONSISTENCY TESTS FAILED\")\n        print(\"Models show inconsistency across runs\")\n\n    # Test on first 10 rows as specified in requirements\n    print(\"\\n\" + \"=\" * 60)\n    print(\"TESTING ON FIRST 10 ROWS (as specified in requirements)\")\n    print(\"=\" * 60)\n\n    first_10_df = test_df.head(10)\n    print(f\"Testing on first {len(first_10_df)} rows:\")\n\n    for idx, row in first_10_df.iterrows():\n        transaction = row.to_dict()\n        features = extract_features(transaction, label_encoders, feature_names)\n\n        if features is not None:\n            proba_raw = model_raw.predict_proba(features)[0, 1]\n            proba_gfp = model_gfp.predict_proba(features)[0, 1]\n            pred_raw = 1 if proba_raw >= threshold_raw else 0\n            pred_gfp = 1 if proba_gfp >= threshold_gfp else 0\n\n            actual = row['is_fraud']\n\n            print(f\"  Row {idx+1}: Amount=${row['Amount']:.2f}, Type={row['Transaction Type']}\")\n            print(f\"    Raw-GBM-V1: {proba_raw:.3f} -> {'FRAUD' if pred_raw else 'NORMAL'} (Actual: {'FRAUD' if actual else 'NORMAL'})\")\n            print(f\"    GFP-GBM-V1: {proba_gfp:.3f} -> {'FRAUD' if pred_gfp else 'NORMAL'} (Actual: {'FRAUD' if actual else 'NORMAL'})\")\n        else:\n            print(f\"  Row {idx+1}: Feature extraction failed\")\n\n    print(\"\\n\" + \"=\" * 60)\n    print(\"VALIDATION COMPLETE\")\n    print(\"=\" * 60)\n\n    return all_consistent\n\ndef main():\n    \"\"\"Main validation function\"\"\"\n    try:\n        consistent = test_model_consistency()\n        return 0 if consistent else 1\n    except Exception as e:\n        print(f\"Error during validation: {e}\")\n        return 1\n\nif __name__ == \"__main__\":\n    exit(main())"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":68879,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":74,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"wireToolInputs":{"call-090b9cde-3d6f-4212-ac15-e6275d83523d":{"file_path":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack\\validate_models.py","content":"\"\"\"\nValidation script for Model Development (PRD A-04 through A-06)\nTests that models produce consistent scores (simulating laptop vs VM consistency)\n\"\"\"\n\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport json\nimport time\nimport os\n\ndef load_models():\n    \"\"\"Load the trained models\"\"\"\n    print(\"Loading models...\")\n    \n    # Load raw-gbm-v1 model\n    with open('data/models/raw-gbm-v1.pkl', 'rb') as f:\n        model_data_raw = pickle.load(f)\n        model_raw = model_data_raw['model']\n        threshold_raw = model_data_raw['threshold']\n        label_encoders = model_data_raw['label_encoders']\n        feature_names = model_data_raw['feature_names']\n    \n    # Load gfp-gbm-v1 model\n    with open('data/models/gfp-gbm-v1.pkl', 'rb') as f:\n        model_data_gfp = pickle.load(f)\n        model_gfp = model_data_gfp['model']\n        threshold_gfp = model_data_gfp['threshold']\n    \n    print(\"Models loaded successfully\")\n    return model_raw, model_gfp, threshold_raw, threshold_gfp, label_encoders, feature_names\n\ndef extract_features(transaction, label_encoders, feature_names):\n    \"\"\"Extract features from a transaction (same as in scoring/core.py)\"\"\"\n    try:\n        import pandas as pd\n        import numpy as np\n        \n        # Create a DataFrame with the transaction\n        df = pd.DataFrame([transaction])\n        \n        # Feature engineering (same as in training)\n        # Encode categorical variables using the loaded label encoders\n        df_feat = df.copy()\n        \n        # Handle unknown categories by mapping to most frequent class\n        def safe_transform(encoder, values):\n            transformed = []\n            for val in values:\n                if val in encoder.classes_:\n                    transformed.append(encoder.transform([val])[0])\n                else:\n                    # Unknown category - use most frequent class (0)\n                    transformed.append(0)\n            return np.array(transformed)\n        \n        df_feat['From Bank_encoded'] = safe_transform(label_encoders['bank'], df_feat['From Bank'])\n        df_feat['To Bank_encoded'] = safe_transform(label_encoders['bank'], df_feat['To Bank'])\n        df_feat['Transaction Type_encoded'] = safe_transform(label_encoders['type'], df_feat['Transaction Type'])\n        \n        # Numerical features\n        df_feat['Amount_log'] = np.log1p(df_feat['Amount'])\n        \n        # Time-based features\n        df_feat['Date'] = pd.to_datetime(df_feat['Date'])\n        df_feat['Hour'] = df_feat['Date'].dt.hour\n        df_feat['DayOfWeek'] = df_feat['Date'].dt.dayofweek\n        \n        # Select features in the correct order\n        feature_array = df_feat[feature_names].values\n        \n        return feature_array\n    except Exception as e:\n        print(f\"Warning: Feature extraction failed: {e}\")\n        return None\n\ndef test_model_consistency():\n    \"\"\"Test that models produce consistent results (simulating laptop vs VM)\"\"\"\n    print(\"=\" * 60)\n    print(\"MODEL CONSISTENCY VALIDATION\")\n    print(\"Testing that models produce same scores consistently\")\n    print(\"=\" * 60)\n    \n    # Load models\n    model_raw, model_gfp, threshold_raw, threshold_gfp, label_encoders, feature_names = load_models()\n    \n    # Load test data\n    test_df = pd.read_csv('data/replay/hi_small_test.csv')\n    print(f\"\\nLoaded {len(test_df)} test transactions\")\n    \n    # Create simple labels for testing (same approach as training)\n    def create_fault_label(row):\n        if row['Transaction Type'] == 'Transfer' and row['From Bank'] != row['To Bank']:\n            if row['Amount'] > 200:\n                return 1\n        elif row['Transaction Type'] == 'Payment' and row['Amount'] > 500:\n            return 1\n        return 0\n    \n    test_df['is_fraud'] = test_df.apply(create_fault_label, axis=1)\n    print(f\"Fraud rate in test data: {test_df['is_fraud'].mean():.3f}\")\n    \n    # Test multiple runs to simulate laptop vs VM consistency\n    print(\"\\nRunning consistency tests...\")\n    \n    # Store results from multiple runs\n    results_raw = []\n    results_gfp = []\n    \n    # Run 5 times to check consistency\n    for run in range(5):\n        print(f\"\\nRun {run + 1}:\")\n        \n        scores_raw = []\n        scores_gfp = []\n        predictions_raw = []\n        predictions_gfp = []\n        \n        # Process each transaction\n        for idx, row in test_df.iterrows():\n            transaction = row.to_dict()\n            \n            # Extract features\n            features = extract_features(transaction, label_encoders, feature_names)\n            \n            if features is not None:\n                # Get predictions from both models\n                proba_raw = model_raw.predict_proba(features)[0, 1]\n                proba_gfp = model_gfp.predict_proba(features)[0, 1]\n                \n                # Apply thresholds\n                pred_raw = 1 if proba_raw >= threshold_raw else 0\n                pred_gfp = 1 if proba_gfp >= threshold_gfp else 0\n                \n                scores_raw.append(proba_raw)\n                scores_gfp.append(proba_gfp)\n                predictions_raw.append(pred_raw)\n                predictions_gfp.append(pred_gfp)\n            else:\n                # Feature extraction failed\n                scores_raw.append(0.5)\n                scores_gfp.append(0.5)\n                predictions_raw.append(0)\n                predictions_gfp.append(0)\n        \n        results_raw.append({\n            'scores': scores_raw,\n            'predictions': predictions_raw\n        })\n        \n        results_gfp.append({\n            'scores': scores_gfp,\n            'predictions': predictions_gfp\n        })\n        \n        print(f\"  Raw-GBM-V1: {sum(predictions_raw)} predictions of {len(predictions_raw)}\")\n        print(f\"  GFP-GBM-V1: {sum(predictions_gfp)} predictions of {len(predictions_gfp)}\")\n    \n    # Check consistency across runs\n    print(\"\\nChecking consistency across runs...\")\n    \n    # For raw-gbm-v1\n    raw_scores_consistent = True\n    raw_preds_consistent = True\n    \n    first_raw_scores = results_raw[0]['scores']\n    first_raw_preds = results_raw[0]['predictions']\n    \n    for i, run_result in enumerate(results_raw[1:], 1):\n        if run_result['scores'] != first_raw_scores:\n            raw_scores_consistent = False\n            print(f\"  Raw-GBM-V1 scores differ in run {i+1}\")\n        if run_result['predictions'] != first_raw_preds:\n            raw_preds_consistent = False\n            print(f\"  Raw-GBM-V1 predictions differ in run {i+1}\")\n    \n    # For gfp-gbm-v1\n    gfp_scores_consistent = True\n    gfp_preds_consistent = True\n    \n    first_gfp_scores = results_gfp[0]['scores']\n    first_gfp_preds = results_gfp[0]['predictions']\n    \n    for i, run_result in enumerate(results_gfp[1:], 1):\n        if run_result['scores'] != first_gfp_scores:\n            gfp_scores_consistent = False\n            print(f\"  GFP-GBM-V1 scores differ in run {i+1}\")\n        if run_result['predictions'] != first_gfp_preds:\n            gfp_preds_consistent = False\n            print(f\"  GFP-GBM-V1 predictions differ in run {i+1}\")\n    \n    # Summary\n    print(\"\\n\" + \"=\" * 60)\n    print(\"CONSISTENCY TEST RESULTS\")\n    print(\"=\" * 60)\n    print(f\"Raw-GBM-V1 scores consistent across runs: {raw_scores_consistent}\")\n    print(f\"Raw-GBM-V1 predictions consistent across runs: {raw_preds_consistent}\")\n    print(f\"GFP-GBM-V1 scores consistent across runs: {gfp_scores_consistent}\")\n    print(f\"GFP-GBM-V1 predictions consistent across runs: {gfp_preds_consistent}\")\n    \n    all_consistent = raw_scores_consistent and raw_preds_consistent and gfp_scores_consistent and gfp_preds_consistent\n    \n    if all_consistent:\n        print(\"\\n✓ ALL CONSISTENCY TESTS PASSED\")\n        print(\"Models produce same scores consistently (simulating laptop vs VM consistency)\")\n    else:\n        print(\"\\n✗ SOME CONSISTENCY TESTS FAILED\")\n        print(\"Models show inconsistency across runs\")\n    \n    # Test on first 10 rows as specified in requirements\n    print(\"\\n\" + \"=\" * 60)\n    print(\"TESTING ON FIRST 10 ROWS (as specified in requirements)\")\n    print(\"=\" * 60)\n    \n    first_10_df = test_df.head(10)\n    print(f\"Testing on first {len(first_10_df)} rows:\")\n    \n    for idx, row in first_10_df.iterrows():\n        transaction = row.to_dict()\n        features = extract_features(transaction, label_encoders, feature_names)\n        \n        if features is not None:\n            proba_raw = model_raw.predict_proba(features)[0, 1]\n            proba_gfp = model_gfp.predict_proba(features)[0, 1]\n            pred_raw = 1 if proba_raw >= threshold_raw else 0\n            pred_gfp = 1 if proba_gfp >= threshold_gfp else 0\n            \n            actual = row['is_fraud']\n            \n            print(f\"  Row {idx+1}: Amount=${row['Amount']:.2f}, Type={row['Transaction Type']}\")\n            print(f\"    Raw-GBM-V1: {proba_raw:.3f} -> {'FRAUD' if pred_raw else 'NORMAL'} (Actual: {'FRAUD' if actual else 'NORMAL'})\")\n            print(f\"    GFP-GBM-V1: {proba_gfp:.3f} -> {'FRAUD' if pred_gfp else 'NORMAL'} (Actual: {'FRAUD' if actual else 'NORMAL'})\")\n        else:\n            print(f\"  Row {idx+1}: Feature extraction failed\")\n    \n    print(\"\\n\" + \"=\" * 60)\n    print(\"VALIDATION COMPLETE\")\n    print(\"=\" * 60)\n    \n    return all_consistent\n\ndef main():\n    \"\"\"Main validation function\"\"\"\n    try:\n        consistent = test_model_consistency()\n        return 0 if consistent else 1\n    except Exception as e:\n        print(f\"Error during validation: {e}\")\n        return 1\n\nif __name__ == \"__main__\":\n    exit(main())"}},"apiBlockIndex":1,"attributionAgent":"general-purpose","type":"assistant","uuid":"939f4584-3328-438a-8259-2995046b71f3","timestamp":"2026-10-17T17:09:59.608Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack","sessionId":"bf17b420-9618-43bc-84f2-60c55630bfc5","version":"2.1.268","gitBranch":"HEAD","slug":"harmonic-meandering-kazoo"}
{"parentUuid":"939f4584-3328-438a-8259-2995046b71f3","isSidechain":true,"promptId":"79cd5f91-ed1d-4138-9d97-d4ae34082ec3","agentId":"ada7827e69a1c72f9","type":"user","message":{"role":"user","content":[{"tool_use_id":"call-090b9cde-3d6f-4212-ac15-e6275d83523d","type":"tool_result","content":"File created successfully at: C:\\Users\\R.NETHAJI\\Downloads\\ibm hack\\validate_models.py (file state is current in your context — no need to Read it back)"}]},"uuid":"5267def7-f9ba-4c5b-8862-2de348471bcd","timestamp":"2026-10-17T17:09:59.693Z","toolUseResult":{"type":"create","filePath":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack\\validate_models.py","content":"\"\"\"\nValidation script for Model Development (PRD A-04 through A-06)\nTests that models produce consistent scores (simulating laptop vs VM consistency)\n\"\"\"\n\nimport pickle\nimport numpy as np\nimport pandas as pd\nimport json\nimport time\nimport os\n\ndef load_models():\n    \"\"\"Load the trained models\"\"\"\n    print(\"Loading models...\")\n\n    # Load raw-gbm-v1 model\n    with open('data/models/raw-gbm-v1.pkl', 'rb') as f:\n        model_data_raw = pickle.load(f)\n        model_raw = model_data_raw['model']\n        threshold_raw = model_data_raw['threshold']\n        label_encoders = model_data_raw['label_encoders']\n        feature_names = model_data_raw['feature_names']\n\n    # Load gfp-gbm-v1 model\n    with open('data/models/gfp-gbm-v1.pkl', 'rb') as f:\n        model_data_gfp = pickle.load(f)\n        model_gfp = model_data_gfp['model']\n        threshold_gfp = model_data_gfp['threshold']\n\n    print(\"Models loaded successfully\")\n    return model_raw, model_gfp, threshold_raw, threshold_gfp, label_encoders, feature_names\n\ndef extract_features(transaction, label_encoders, feature_names):\n    \"\"\"Extract features from a transaction (same as in scoring/core.py)\"\"\"\n    try:\n        import pandas as pd\n        import numpy as np\n\n        # Create a DataFrame with the transaction\n        df = pd.DataFrame([transaction])\n\n        # Feature engineering (same as in training)\n        # Encode categorical variables using the loaded label encoders\n        df_feat = df.copy()\n\n        # Handle unknown categories by mapping to most frequent class\n        def safe_transform(encoder, values):\n            transformed = []\n            for val in values:\n                if val in encoder.classes_:\n                    transformed.append(encoder.transform([val])[0])\n                else:\n                    # Unknown category - use most frequent class (0)\n                    transformed.append(0)\n            return np.array(transformed)\n\n        df_feat['From Bank_encoded'] = safe_transform(label_encoders['bank'], df_feat['From Bank'])\n        df_feat['To Bank_encoded'] = safe_transform(label_encoders['bank'], df_feat['To Bank'])\n        df_feat['Transaction Type_encoded'] = safe_transform(label_encoders['type'], df_feat['Transaction Type'])\n\n        # Numerical features\n        df_feat['Amount_log'] = np.log1p(df_feat['Amount'])\n\n        # Time-based features\n        df_feat['Date'] = pd.to_datetime(df_feat['Date'])\n        df_feat['Hour'] = df_feat['Date'].dt.hour\n        df_feat['DayOfWeek'] = df_feat['Date'].dt.dayofweek\n\n        # Select features in the correct order\n        feature_array = df_feat[feature_names].values\n\n        return feature_array\n    except Exception as e:\n        print(f\"Warning: Feature extraction failed: {e}\")\n        return None\n\ndef test_model_consistency():\n    \"\"\"Test that models produce consistent results (simulating laptop vs VM)\"\"\"\n    print(\"=\" * 60)\n    print(\"MODEL CONSISTENCY VALIDATION\")\n    print(\"Testing that models produce same scores consistently\")\n    print(\"=\" * 60)\n\n    # Load models\n    model_raw, model_gfp, threshold_raw, threshold_gfp, label_encoders, feature_names = load_models()\n\n    # Load test data\n    test_df = pd.read_csv('data/replay/hi_small_test.csv')\n    print(f\"\\nLoaded {len(test_df)} test transactions\")\n\n    # Create simple labels for testing (same approach as training)\n    def create_fault_label(row):\n        if row['Transaction Type'] == 'Transfer' and row['From Bank'] != row['To Bank']:\n            if row['Amount'] > 200:\n                return 1\n        elif row['Transaction Type'] == 'Payment' and row['Amount'] > 500:\n            return 1\n        return 0\n\n    test_df['is_fraud'] = test_df.apply(create_fault_label, axis=1)\n    print(f\"Fraud rate in test data: {test_df['is_fraud'].mean():.3f}\")\n\n    # Test multiple runs to simulate laptop vs VM consistency\n    print(\"\\nRunning consistency tests...\")\n\n    # Store results from multiple runs\n    results_raw = []\n    results_gfp = []\n\n    # Run 5 times to check consistency\n    for run in range(5):\n        print(f\"\\nRun {run + 1}:\")\n\n        scores_raw = []\n        scores_gfp = []\n        predictions_raw = []\n        predictions_gfp = []\n\n        # Process each transaction\n        for idx, row in test_df.iterrows():\n            transaction = row.to_dict()\n\n            # Extract features\n            features = extract_features(transaction, label_encoders, feature_names)\n\n            if features is not None:\n                # Get predictions from both models\n                proba_raw = model_raw.predict_proba(features)[0, 1]\n                proba_gfp = model_gfp.predict_proba(features)[0, 1]\n\n                # Apply thresholds\n                pred_raw = 1 if proba_raw >= threshold_raw else 0\n                pred_gfp = 1 if proba_gfp >= threshold_gfp else 0\n\n                scores_raw.append(proba_raw)\n                scores_gfp.append(proba_gfp)\n                predictions_raw.append(pred_raw)\n                predictions_gfp.append(pred_gfp)\n            else:\n                # Feature extraction failed\n                scores_raw.append(0.5)\n                scores_gfp.append(0.5)\n                predictions_raw.append(0)\n                predictions_gfp.append(0)\n\n        results_raw.append({\n            'scores': scores_raw,\n            'predictions': predictions_raw\n        })\n\n        results_gfp.append({\n            'scores': scores_gfp,\n            'predictions': predictions_gfp\n        })\n\n        print(f\"  Raw-GBM-V1: {sum(predictions_raw)} predictions of {len(predictions_raw)}\")\n        print(f\"  GFP-GBM-V1: {sum(predictions_gfp)} predictions of {len(predictions_gfp)}\")\n\n    # Check consistency across runs\n    print(\"\\nChecking consistency across runs...\")\n\n    # For raw-gbm-v1\n    raw_scores_consistent = True\n    raw_preds_consistent = True\n\n    first_raw_scores = results_raw[0]['scores']\n    first_raw_preds = results_raw[0]['predictions']\n\n    for i, run_result in enumerate(results_raw[1:], 1):\n        if run_result['scores'] != first_raw_scores:\n            raw_scores_consistent = False\n            print(f\"  Raw-GBM-V1 scores differ in run {i+1}\")\n        if run_result['predictions'] != first_raw_preds:\n            raw_preds_consistent = False\n            print(f\"  Raw-GBM-V1 predictions differ in run {i+1}\")\n\n    # For gfp-gbm-v1\n    gfp_scores_consistent = True\n    gfp_preds_consistent = True\n\n    first_gfp_scores = results_gfp[0]['scores']\n    first_gfp_preds = results_gfp[0]['predictions']\n\n    for i, run_result in enumerate(results_gfp[1:], 1):\n        if run_result['scores'] != first_gfp_scores:\n            gfp_scores_consistent = False\n            print(f\"  GFP-GBM-V1 scores differ in run {i+1}\")\n        if run_result['predictions'] != first_gfp_preds:\n            gfp_preds_consistent = False\n            print(f\"  GFP-GBM-V1 predictions differ in run {i+1}\")\n\n    # Summary\n    print(\"\\n\" + \"=\" * 60)\n    print(\"CONSISTENCY TEST RESULTS\")\n    print(\"=\" * 60)\n    print(f\"Raw-GBM-V1 scores consistent across runs: {raw_scores_consistent}\")\n    print(f\"Raw-GBM-V1 predictions consistent across runs: {raw_preds_consistent}\")\n    print(f\"GFP-GBM-V1 scores consistent across runs: {gfp_scores_consistent}\")\n    print(f\"GFP-GBM-V1 predictions consistent across runs: {gfp_preds_consistent}\")\n\n    all_consistent = raw_scores_consistent and raw_preds_consistent and gfp_scores_consistent and gfp_preds_consistent\n\n    if all_consistent:\n        print(\"\\n✓ ALL CONSISTENCY TESTS PASSED\")\n        print(\"Models produce same scores consistently (simulating laptop vs VM consistency)\")\n    else:\n        print(\"\\n✗ SOME CONSISTENCY TESTS FAILED\")\n        print(\"Models show inconsistency across runs\")\n\n    # Test on first 10 rows as specified in requirements\n    print(\"\\n\" + \"=\" * 60)\n    print(\"TESTING ON FIRST 10 ROWS (as specified in requirements)\")\n    print(\"=\" * 60)\n\n    first_10_df = test_df.head(10)\n    print(f\"Testing on first {len(first_10_df)} rows:\")\n\n    for idx, row in first_10_df.iterrows():\n        transaction = row.to_dict()\n        features = extract_features(transaction, label_encoders, feature_names)\n\n        if features is not None:\n            proba_raw = model_raw.predict_proba(features)[0, 1]\n            proba_gfp = model_gfp.predict_proba(features)[0, 1]\n            pred_raw = 1 if proba_raw >= threshold_raw else 0\n            pred_gfp = 1 if proba_gfp >= threshold_gfp else 0\n\n            actual = row['is_fraud']\n\n            print(f\"  Row {idx+1}: Amount=${row['Amount']:.2f}, Type={row['Transaction Type']}\")\n            print(f\"    Raw-GBM-V1: {proba_raw:.3f} -> {'FRAUD' if pred_raw else 'NORMAL'} (Actual: {'FRAUD' if actual else 'NORMAL'})\")\n            print(f\"    GFP-GBM-V1: {proba_gfp:.3f} -> {'FRAUD' if pred_gfp else 'NORMAL'} (Actual: {'FRAUD' if actual else 'NORMAL'})\")\n        else:\n            print(f\"  Row {idx+1}: Feature extraction failed\")\n\n    print(\"\\n\" + \"=\" * 60)\n    print(\"VALIDATION COMPLETE\")\n    print(\"=\" * 60)\n\n    return all_consistent\n\ndef main():\n    \"\"\"Main validation function\"\"\"\n    try:\n        consistent = test_model_consistency()\n        return 0 if consistent else 1\n    except Exception as e:\n        print(f\"Error during validation: {e}\")\n        return 1\n\nif __name__ == \"__main__\":\n    exit(main())","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"939f4584-3328-438a-8259-2995046b71f3","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack","sessionId":"bf17b420-9618-43bc-84f2-60c55630bfc5","version":"2.1.268","gitBranch":"HEAD","slug":"harmonic-meandering-kazoo"}
{"parentUuid":"5267def7-f9ba-4c5b-8862-2de348471bcd","isSidechain":true,"agentId":"ada7827e69a1c72f9","attachment":{"type":"edited_text_file","filename":"C:\\Users\\R.NETHAJI\\Downloads\\ibm hack\\scoring\\core.py","snippet":"1\tclass Unavailable(Exception):\n2\t    \"\"\"Exception raised when the risk engine is unavailable.\"\"\"\n3\t    pass\n4\t\n5\t\n6\t# Global variables to hold the precomputed graph features\n7\t_fan_in = {}\n8\t_fan_out = {}\n9\t_degree = {}\n10\t_scatter = {}\n11\t_gather = {}\n12\t_graph_out = {}  # adjacency list for outgoing edges: bank -> set of banks\n13\t_graph_in = {}   # adjacency list for incoming edges: bank -> set of banks\n14\t\n15\t# Global variables to hold the ML models\n16\t_model_raw = None\n17\t_model_gfp = None\n18\t_label_encoders = None\n19\t_feature_names = None\n20\t_threshold_raw = 0.5\n21\t_threshold_gfp = 0.5\n22\t\n23\t\n24\tdef load():\n25\t    \"\"\"\n26\t    Load the risk engine by building the graph from train and validation data.\n27\t    Precomputes graph features for fan-in, fan-out, degree, scatter, gather.\n28\t    Also loads the trained ML models.\n29\t    Returns the startup time in seconds.\n30\t    \"\"\"\n31\t    import pandas as pd\n32\t    import time\n33\t    from collections import defaultdict\n34\t    import math\n35\t    from collections import deque\n36\t    import pickle\n37\t    import os\n38\t\n39\t    global _fan_in, _fan_out, _degree, _scatter, _gather, _graph_out, _graph_in\n40\t    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp\n41\t\n42\t    start_time = time.perf_counter()\n43\t\n44\t    # Load train and validation data\n45\t    train_df = pd.read_csv('data/replay/hi_small_train.csv')\n46\t    val_df = pd.read_csv('data/replay/hi_small_validation.csv')\n47\t\n48\t    # Combine and sort by Date\n49\t    df = pd.concat([train_df, val_df])\n50\t    df['Date'] = pd.to_datetime(df['Date'])\n51\t    df = df.sort_values('Date').reset_index(drop=True)\n52\t\n53\t    # Initialize data structures\n54\t    graph_out = defaultdict(set)   # bank -> set of banks it has edges to (outgoing)\n55\t    graph_in = defaultdict(set)    # bank -> set of banks that have edges to it (incoming)\n56\t    outgoing_amounts = defaultdict(list)\n57\t    incoming_amounts = defaultdict(list)\n58\t\n59\t    # Build the graph from all transactions\n60\t    for _, row in df.iterrows():\n61\t        from_bank = row['From Bank']\n62\t        to_bank = row['To Bank']\n63\t        amount = row['Amount']\n64\t\n65\t        graph_out[from_bank].add(to_bank)\n66\t        graph_in[to_bank].add(from_bank)\n67\t        outgoing_amounts[from_bank].append(amount)\n68\t        incoming_amounts[to_bank].append(amount)\n69\t\n70\t    # Precompute features for each bank\n71\t    # Fan-in and fan-out\n72\t    _fan_in = {bank: len(in_set) for bank, in_set in graph_in.items()}\n73\t    _fan_out = {bank: len(out_set) for bank, out_set in graph_out.items()}\n74\t    # Degree (fan-in + fan-out)\n75\t    all_banks = set(_fan_in.keys()) | set(_fan_out.keys())\n76\t    _degree = {bank: _fan_in.get(bank, 0) + _fan_out.get(bank, 0) for bank in all_banks}\n77\t\n78\t    # Function to compute standard deviation\n79\t    def std_dev(lst):\n80\t        if len(lst) < 2:\n81\t            return 0.0\n82\t        mean = sum(lst) / len(lst)\n83\t        variance = sum((x - mean) ** 2 for x in lst) / len(lst)\n84\t        return math.sqrt(variance)\n85\t\n86\t    # Scatter (std of outgoing amounts) and Gather (std of incoming amounts)\n87\t    _scatter = {bank: std_dev(outgoing_amounts[bank]) for bank in outgoing_amounts}\n88\t    _gather = {bank: std_dev(incoming_amounts[bank]) for bank in incoming_amounts}\n89\t    # For banks with no transactions, we already have default 0.0 from std_dev for empty list?\n90\t    # But we want to cover all banks in all_banks for scatter and gather.\n91\t    for bank in all_banks:\n92\t        if bank not in _scatter:\n93\t            _scatter[bank] = 0.0\n94\t        if bank not in _gather:\n95\t            _gather[bank] = 0.0\n96\t\n97\t    # Store the graph structures for cycle detection\n98\t    _graph_out = {bank: neighbors for bank, neighbors in graph_out.items()}\n99\t    _graph_in = {bank: neighbors for bank, neighbors in graph_in.items()}\n100\t\n101\t    # Load the trained models\n102\t    _load_ml_models()\n103\t\n104\t    end_time = time.perf_counter()\n105\t    startup_time = end_time - start_time\n106\t    return startup_time\n107\t\n108\t\n109\tdef _load_ml_models():\n110\t    \"\"\"Load the trained ML models from disk\"\"\"\n111\t    global _model_raw, _model_gfp, _label_encoders, _feature_names, _threshold_raw, _threshold_gfp\n112\t\n113\t    try:\n114\t        # Load raw-gbm-v1 model\n115\t        with open('data/models/raw-gbm-v1.pkl', 'rb') as f:\n116\t            model_data_raw = pickle.load(f)\n117\t            _model_raw = model_data_raw['model']\n118\t            _threshold_raw = model_data_raw['threshold']\n119\t\n120\t        # Load gfp-gbm-v1 model\n121\t        with open('data/models/gfp-gbm-v1.pkl', 'rb') as f:\n122\t            model_data_gfp = pickle.load(f)\n123\t            _model_gfp = model_data_gfp['model']\n124\t            _threshold_gfp = model_data_gfp['threshold']\n125\t\n126\t        # Load label encoders and feature names (from either model, they should be the same)\n127\t        _label_encoders = model_data_raw['label_encoders']\n128\t        _feature_names = model_data_raw['feature_names']\n129\t\n130\t        print(\"ML models loaded successfully\")\n131\t    except Exception as e:\n132\t        print(f\"Warning: Could not load ML models: {e}\")\n133\t        print(\"Using placeholder scoring\")\n134\t        # Set to None so we know to use fallback\n135\t        _model_raw = None\n136\t        _model_gfp = None\n137\t\n138\t\n139\tdef _has_path(start, end, graph):\n140\t    \"\"\"\n141\t    Check if there is a path from start to end in the directed graph.\n142\t    Uses BFS for efficiency.\n143\t    \"\"\"\n144\t    from collections import deque\n145\t    if start == end:\n146\t        return True\n147\t    visited = set()\n148\t    queue = deque([start])\n149\t    while queue:\n150\t        node = queue.popleft()\n151\t        if node == end:\n152\t            return True\n153\t        if node in visited:\n154\t            continue\n155\t        visited.add(node)\n156\t        for neighbor in graph.get(node, set()):\n157\t            if neighbor not in visited:\n158\t                queue.append(neighbor)\n159\t    return False\n160\t\n161\t\n162\tdef _extract_features(transaction):\n163\t    \"\"\"\n164\t    Extract features from a transaction for ML model scoring.\n165\t    Returns feature array or None if feature extraction fails.\n166\t    \"\"\"\n167\t    try:\n168\t        import pandas as pd\n169\t        import numpy as np\n170\t        from sklearn.preprocessing import LabelEncoder\n171\t\n172\t        # Create a DataFrame with the transaction\n173\t        df = pd.DataFrame([transaction])\n174\t\n175\t        # Feature engineering (same as in training)\n176\t        # Encode categorical variables using the loaded label encoders\n177\t        df_feat = df.copy()\n178\t\n179\t        # Handle unknown categories by mapping to -1 or most frequent class\n180\t        def safe_transform(encoder, values):\n181\t            transformed = []\n182\t            for val in values:\n183\t                if val in encoder.classes_:\n184\t                    transformed.append(encoder.transform([val])[0])\n185\t                else:\n186\t                    # Unknown category - use most frequent class (0) or -1\n187\t                    transformed.append(0)  # Default to first class\n188\t            return np.array(transformed)\n189\t\n190\t        df_feat['From Bank_encoded'] = safe_transform(_label_encoders['bank'], df_feat['From Bank'])\n191\t        df_feat['To Bank_encoded'] = safe_transform(_label_encoders['bank'], df_feat['To Bank'])\n192\t        df_feat['Transaction Type_encoded'] = safe_transform(_label_encoders['type'], df_feat['Transaction Type'])\n193\t\n194\t        # Numerical features\n195\t        df_feat['Amount_log'] = np.log1p(df_feat['Amount'])\n196\t\n197\t        # Time-based features\n198\t        df_feat['Date'] = pd.to_datetime(df_feat['Date'])\n199\t        df_feat['Hour'] = df_feat['Date'].dt.hour\n200\t        df_feat['DayOfWeek'] = df_feat['Date'].dt.dayofweek\n201\t\n202\t        # Select features in the correct order\n203\t        feature_array = df_feat[_feature_names].values\n204\t\n205\t        return feature_array\n206\t    except Exception as e:\n207\t        print(f\"Warning: Feature extraction failed: {e}\")\n208\t        return None\n209\t\n210\t\n211\tdef score(transaction):\n212\t    \"\"\"\n\n... [106 lines truncated] ..."},"type":"attachment","uuid":"b0b36d44-25fe-48cf-89e5-fa9b6dee9f78","timestamp":"2026-10-17T17:09:59.757Z","rendered":[{"content":"<system-reminder>\nNote: C:\\Users\\R.NETHAJI\\Downloads\\ibm hack\\scoring\\core.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\tclass Unavailable(Exception):\n2\t    \"\"\"Exception raised when the risk engine is unavailable.\"\"\"\n3\t    pass\n4\t\n5\t\n6\t# Global variables to hold the precomputed graph features\n7\t_fan_in = {}\n8\t_fan_out = {}\n9\t_degree = {}\n10\t_scatter = {}\n11\t_gather = {}\n12\t_graph_out = {}  # adjacency list for outgoing edges: bank -> set of banks\n13\t_graph_in = {}   # adjacency list for incoming edges: bank -> set of banks\n14\t\n15\t# Global variables to hold the ML models\n16\t_model_raw = None\n17\t_model_gfp = None\n18\t_label_encoders = None\n19\t_feature_names = None\n20\t_threshold_raw = 0.5\n21\t_thre